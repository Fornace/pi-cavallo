{
  "name": "pi-cavallo",
  "version": "2.2.0",
  "description": "Generate and edit video in pi using Alibaba video models: HappyHorse 1.1/1.0, Wan 3.0, Wan 2.7 (T2V, I2V, R2V, Video-Edit). Auto-selected defaults, per-task-type overrides.",
  "author": "Francesco Frapporti <effedue@gmail.com>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Fornace/pi-cavallo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fornace/pi-cavallo.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "alibaba",
    "dashscope",
    "happyhorse",
    "video-generation",
    "terminal"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "extensions/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/load.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.0.0",
    "jiti": "^2.7.0",
    "typebox": "^1.1.24",
    "typescript": "^6.0.3"
  }
}
